# Configuration PostgreSQL
POSTGRES_USER=microphina
POSTGRES_PASSWORD=microphina
POSTGRES_DB=db_microphina
POSTGRES_PORT=5432

# URL pour Prisma (utilisée par votre application)
# 'localhost' si vous lancez Prisma depuis votre machine
# 'db' si Prisma tourne dans un conteneur sur le même réseau
DATABASE_URL="postgresql://microphina:microphina@localhost:5432/db_microphina?schema=public"
