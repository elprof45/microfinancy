generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleUtilisateur {
  ADMIN
  CAISSIER
  COLLECTEUR
}

enum TypeMouvement {
  VERSEMENT
  RETRAIT
  DEPOT
}

enum StatutTransaction {
  EN_ATTENTE
  VALIDE
  REJETE
  ANNULE
  REMBOURSE
}

model Societe {
  id            Int       @id @default(autoincrement())
  nom           String
  raisonSociale String?
  identifiant   String?   @unique
  email         String?
  telephone     String?
  adresse       String?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agences      Agence[]
  utilisateurs Utilisateur[] @relation("SocieteUtilisateurs")
}

model Agence {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  nom       String
  adresse   String?
  telephone String?
  zoneId    Int?
  societeId Int
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  caissiers         Utilisateur[]      @relation("AgenceCaissiers")
  collecteurs       Utilisateur[]      @relation("AgenceCollecteurs")
  clients           ClientTotine[]
  comptes           Compte[]
  mouvementsEpargne MouvementEpargne[]
  utilisateurs      Utilisateur[]
  cotisations       Cotisation[]
  mouvementTotines  MouvementTotine[]
}

model Utilisateur {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  motDePasseHash String
  nom            String
  telephone      String?
  role           RoleUtilisateur @default(CAISSIER)
  societeId      Int?
  agenceId       Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  societe Societe? @relation("SocieteUtilisateurs", fields: [societeId], references: [id])
  agence  Agence?  @relation(fields: [agenceId], references: [id], map: "Utilisateur_agenceId_fkey")

  agenceCaissier    Agence?            @relation("AgenceCaissiers", fields: [agenceId], references: [id], map: "Utilisateur_agenceId_caissier_fkey")
  agenceCollecteur  Agence?            @relation("AgenceCollecteurs", fields: [agenceId], references: [id], map: "Utilisateur_agenceId_collecteur_fkey")
  mouvements        MouvementItem[]
  createdMouvements MouvementEpargne[] @relation("CreatedBy")
  clientTotines     ClientTotine[]
  carnets           Carnet[]
  cotisations       Cotisation[]
  mouvementTotines  MouvementTotine[]
  clientSoldes      ClientSolde[]
}

model Compte {
  id              Int       @id @default(autoincrement())
  numeroCompte    String    @unique
  typeCompte      String // "EPARGNE", "COURANT", "ADC", "TONTINE"...
  solde           Decimal   @default(0)
  soldeDisponible Decimal   @default(0)
  dateOuverture   DateTime  @default(now())
  dateCloture     DateTime?
  clientId        Int?
  agenceId        Int
  deviseId        String
  isActif         Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client ClientTotine? @relation(fields: [clientId], references: [id])
  agence Agence        @relation(fields: [agenceId], references: [id])

  mouvements        MouvementItem[]
  mouvementEpargnes MouvementEpargne[]
}

model MouvementEpargne {
  id            Int               @id @default(autoincrement())
  reference     String            @unique
  type          TypeMouvement
  montant       Decimal
  soldeAvant    Decimal
  soldeApres    Decimal
  dateMouvement DateTime          @default(now())
  statut        StatutTransaction @default(EN_ATTENTE)
  observations  String?
  agenceId      Int
  clientId      Int?
  compteId      Int?
  creeParId     Int
  valideParId   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agence            Agence           @relation(fields: [agenceId], references: [id])
  client            ClientTotine?    @relation(fields: [clientId], references: [id])
  compte            Compte?          @relation(fields: [compteId], references: [id])
  creePar           Utilisateur      @relation("CreatedBy", fields: [creeParId], references: [id])
  cotisation        Cotisation?      @relation(fields: [cotisationId], references: [id])
  cotisationId      Int?
  mouvementTotine   MouvementTotine? @relation(fields: [mouvementTotineId], references: [id])
  mouvementTotineId Int?
}

model MouvementItem {
  id         Int               @id @default(autoincrement())
  reference  String?
  type       String
  montant    Decimal
  date       DateTime
  compteId   Int?
  caissierId Int?
  statut     StatutTransaction @default(VALIDE)

  createdAt DateTime @default(now())

  caissier          Utilisateur?     @relation(fields: [caissierId], references: [id])
  compte            Compte?          @relation(fields: [compteId], references: [id])
  cotisation        Cotisation?      @relation(fields: [cotisationId], references: [id])
  cotisationId      Int?
  mouvementTotine   MouvementTotine? @relation(fields: [mouvementTotineId], references: [id])
  mouvementTotineId Int?
}

model ClientTotine {
  id                Int     @id @default(autoincrement())
  numeroClient      String  @unique
  nom               String
  telephone         String?
  email             String?
  agentCollecteurId Int
  agenceId          Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agence       Agence      @relation(fields: [agenceId], references: [id])
  utilisateurs Utilisateur @relation(fields: [agentCollecteurId], references: [id])

  comptes          Compte[]
  mouvements       MouvementEpargne[]
  carnets          Carnet[]
  cotisations      Cotisation[]
  mouvementTotines MouvementTotine[]
  clientSoldes     ClientSolde[]
}

model Carnet {
  id                Int      @id @default(autoincrement())
  numeroCarnet      String   @unique
  agentCollecteurId Int
  clientTotineId    Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client           ClientTotine?     @relation(fields: [clientTotineId], references: [id])
  utilisateurs     Utilisateur?      @relation(fields: [agentCollecteurId], references: [id])
  cotisations      Cotisation[]
  mouvementTotines MouvementTotine[]
}

enum Mois {
  JANVIER
  FEVRIER
  MARS
  AVRIL
  MAI
  JUIN
  JUILLET
  AOUT
  SEPTEMBRE
  OCTOBRE
  NOVEMBRE
  DECEMBRE
}

model Cotisation {
  id                Int       @id @default(autoincrement())
  mois              Mois
  annee             Int
  mise              Decimal
  clientId          Int
  carnetId          Int
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  soldeDeCloture    Decimal?
  soldeDisponible   Decimal
  dateOuverture     DateTime  @default(now())
  dateCloture       DateTime?
  agenceId          Int
  agentCollecteurId Int
  isActif           Boolean   @default(true)

  mouvements        MouvementItem[]
  agence            Agence             @relation(fields: [agenceId], references: [id])
  utilisateurs      Utilisateur?       @relation(fields: [agentCollecteurId], references: [id])
  client            ClientTotine       @relation(fields: [clientId], references: [id])
  carnet            Carnet             @relation(fields: [carnetId], references: [id])
  mouvementEpargnes MouvementEpargne[]
}

model MouvementTotine {
  id                Int                @id @default(autoincrement())
  jour              Int
  montant           Decimal
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  carnetId          Int
  carnet            Carnet             @relation(fields: [carnetId], references: [id])
  agence            Agence?            @relation(fields: [agenceId], references: [id])
  agenceId          Int?
  utilisateur       Utilisateur?       @relation(fields: [utilisateurId], references: [id])
  utilisateurId     Int?
  mouvementEpargnes MouvementEpargne[]
  mouvementItems    MouvementItem[]
  clientTotine      ClientTotine?      @relation(fields: [clientTotineId], references: [id])
  clientTotineId    Int?
}

model ClientSolde {
  id                Int     @id @default(autoincrement())
  clientId          Int
  soldeTotal        Decimal
  agenceId          Int
  agentCollecteurId Int
  isActif           Boolean @default(true)

  client       ClientTotine? @relation(fields: [clientId], references: [id])
  utilisateurs Utilisateur?  @relation(fields: [agentCollecteurId], references: [id])
}
